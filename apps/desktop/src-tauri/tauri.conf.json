{
  "productName": "Gentle Shell Desktop",
  "version": "0.1.12",
  "identifier": "dev.gentle.desk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Gentle Shell Desktop",
        "width": 1000,
        "height": 700,
        "visible": false,
        "backgroundColor": "#0e1116"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Gentle Shell",
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Desktop client for gentle-shell",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ0QTY0QkYzNDNDMjY3RTYKUldUbVo4SkQ4MHVtUklzVFA4WnhFYWdNdVNUajZDV3ZjK2FpalQ4aytUWS9XL29MQkVTWWJBcmgK",
      "endpoints": [
        "https://github.com/ashcroft08/gentle-desk/releases/latest/download/latest.json"
      ]
    }
  }
}
